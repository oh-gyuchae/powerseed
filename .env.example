DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 운영 공개 주소 (인스타 웹훅 콜백 URL 기준)
SITE_BASE_URL=http://127.0.0.1:8000
# Google Forms — 서비스 계정 JSON 경로. 폼마다 이 계정의 client_email을 편집자로 공유
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
# Gmail 발송 (구글 계정 2단계 인증 → 앱 비밀번호 생성)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=PowerSeed
# 로컬에서 실제로 보내지 않고 콘솔에 출력: django.core.mail.backends.console.EmailBackend
GMAIL_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Instagram DM (Meta 개발자 앱 → Instagram API with Instagram Login)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=me
META_APP_SECRET=
# 웹훅 등록 시 Meta에 입력할 임의 문자열 (콜백 URL: https://<도메인>/hooks/instagram/)
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v23.0
# 해시태그 수집기: collect(hashtag, limit) -> Iterable[dict] 의 import 경로 (예: collector.vendor.scraper.collect)
COLLECTOR_SCRAPER=
COLLECTOR_DEFAULT_LIMIT=200
COLLECTOR_MAX_LIMIT=1000
COLLECTOR_MAX_ATTEMPTS=3
COLLECTOR_RETRY_DELAY=5
# Apify 클라우드 수집 (설정하면 COLLECTOR_SCRAPER보다 우선, 녹스·PC 불필요)
APIFY_TOKEN=
# APIFY_HASHTAG_ACTOR=apify~instagram-hashtag-scraper
# APIFY_PROFILE_ACTOR=apify~instagram-profile-scraper
